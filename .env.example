# ---- database ----
DATABASE_URL="postgresql://awr:awr@localhost:5432/awr_coaching?schema=public"

# ---- api ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
COOKIE_DOMAIN="localhost"

# ---- auth providers ----
# "password" today; add "azure-ad" to enable SSO alongside it.
AUTH_PROVIDERS="password"
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# ---- object storage (MinIO locally, S3 in prod) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="awr-coaching"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ---- web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- seed ----
SEED_ADMIN_EMAIL="admin@awr.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_WORKBOOK_PATH="../../AWR Care and Claims CF-MF.xlsm"
